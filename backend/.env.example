# Copy this file to backend/.env and fill in real values. Never commit .env.

# Neon "main" branch (demo data). Use the DIRECT connection string (host without "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ca-central-1.aws.neon.tech/washslot?sslmode=require

# Your OWN Neon test branch. Tests wipe every table in it. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyyy.ca-central-1.aws.neon.tech/washslot?sslmode=require

# JWT signed with RS256: a private key signs at login, the public key verifies.
# The key files live in backend/keys/ (git-ignored). Make them once with: python scripts/generate_keys.py
JWT_PRIVATE_KEY_FILE=keys/jwt_private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt_public.pem
JWT_ISSUER=https://auth.washslot.local
JWT_AUDIENCE=https://api.washslot.local
JWT_EXPIRES_MINUTES=60

# Resend API key (used from US-6.1)
RESEND_API_KEY=

# Comma-separated front-end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HOLD_MINUTES=10
